# Copia questo file come «.env» (stesso nome, senza .example) e compilalo.
# Il file .env non va mai messo in OneDrive ne' condiviso: contiene la password
# del gestionale.

# Le credenziali con cui accedi a panel.locker-vendor.example
PISA_EMAIL=
PISA_PASSWORD=

# Facoltativo. Se l'account vede piu' di un chiosco, filtra solo Pisa.
# Si legge dal pannello, sezione Chioschi. Lasciare vuoto per scaricare tutto.
PISA_HUB_ID=

# Google Sheet di destinazione.
# SHEET_ID e' la parte lunga dell'URL del foglio, tra /d/ e /edit.
SHEET_ID=
SHEET_TAB=Depositi Pisa
SHEET_TAB_INVII=Lista invio

# Percorso del file JSON del service account Google (vedi README, punto 3).
GOOGLE_SERVICE_ACCOUNT_JSON=C:\path\to\automations\pisa-export\service-account.json

# Copy this file as ".env" (same name, without .example) and fill it in.
# The .env file must never be put on OneDrive nor shared: it contains the
# management-system password.

# The credentials you use to log into panel.locker-vendor.example
PISA_EMAIL=
PISA_PASSWORD=

# Optional. If the account sees more than one kiosk, filter to Pisa only.
# Read it from the panel, Kiosks section. Leave empty to download everything.
PISA_HUB_ID=

# Destination Google Sheet.
# SHEET_ID is the long part of the sheet's URL, between /d/ and /edit.
SHEET_ID=
SHEET_TAB=Depositi Pisa
SHEET_TAB_INVII=Lista invio

# Path to the Google service account JSON file (see README, step 3).
GOOGLE_SERVICE_ACCOUNT_JSON=C:\path\to\automations\pisa-export\service-account.json

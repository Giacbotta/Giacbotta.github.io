# Copia questo file come «.env» (stesso nome, senza .example) e compilalo.
# Il file .env non va mai messo in OneDrive ne' condiviso: contiene la
# System password del pannello che comanda i cassetti di Cannaregio.

# Lo User Name della prima schermata di panel.kiosk-vendor.example.
PROMOTEC_USER=

# La «System password» della seconda schermata.
PROMOTEC_PASSWORD=

# Quale dei tre impianti aprire. I bottoni disponibili al 18/08/2026 sono
# «Luggage Cannaregio cloud», «Luggage Cannaregio» e «Luggage Cannaregio Dyn».
# Quello in uso e' il terzo. Il nome va scritto per intero: la corrispondenza
# e' esatta, cosi' non si apre l'impianto sbagliato per una parola in comune.
PROMOTEC_SISTEMA=Luggage Cannaregio Dyn

# --- API SOAP del totem (lockers.asmx) -------------------------------------
# Endpoint: https://panel.kiosk-vendor.example/lockers.asmx
# VENEZIA_API_KEY     la chiave attivata dal fornitore
# VENEZIA_RECIPIENT   il MAC address del totem
# VENEZIA_PORT        11000, salvo indicazione diversa
# VENEZIA_MASTERCODE  il codice master impostato nel totem
VENEZIA_API_KEY=
VENEZIA_RECIPIENT=
VENEZIA_PORT=11000
VENEZIA_MASTERCODE=

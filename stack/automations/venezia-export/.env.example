# Copy this file as ".env" (same name, without .example) and fill it in.
# The .env file must never be put in OneDrive or shared: it holds the
# System password of the panel that commands the Cannaregio lockers.

# The User Name from the first screen of panel.kiosk-vendor.example.
PROMOTEC_USER=

# The "System password" from the second screen.
PROMOTEC_PASSWORD=

# Which of the three systems to open. The buttons available on 18/08/2026 are
# "Luggage Cannaregio cloud", "Luggage Cannaregio" and "Luggage Cannaregio Dyn".
# The one in use is the third. The name must be written in full: the match
# is exact, so the wrong system is not opened over a shared word.
PROMOTEC_SISTEMA=Luggage Cannaregio Dyn

# --- SOAP API of the kiosk (lockers.asmx) ----------------------------------
# Endpoint: https://panel.kiosk-vendor.example/lockers.asmx
# VENEZIA_API_KEY     the key enabled by the vendor
# VENEZIA_RECIPIENT   the MAC address of the kiosk
# VENEZIA_PORT        11000, unless told otherwise
# VENEZIA_MASTERCODE  the master code set in the kiosk
VENEZIA_API_KEY=
VENEZIA_RECIPIENT=
VENEZIA_PORT=11000
VENEZIA_MASTERCODE=
